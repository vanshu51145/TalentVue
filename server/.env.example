# TalentVue backend — copy to server/.env and fill in real values.
# NEVER commit the real .env. Never paste secrets into this file.

# Port the Express server listens on (Render injects PORT automatically)
PORT=5000

# MongoDB Atlas connection string (SRV). Use your Atlas user/password.
# The server exits on boot if this is missing.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/talentvue?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens (generate a long random string).
# The server exits on boot if this is missing / invalid length.
JWT_SECRET=replace-with-a-long-random-string

# Shared secret for internal AI-service endpoints (resumes scores/analysis).
# Leave out if unused; internal endpoints return 503 without it.
INTERNAL_API_KEY=replace-with-a-long-random-string

# Comma-separated exact browser origins allowed by CORS.
# No trailing slashes. Requests without an Origin header are unaffected.
# The server exits on boot if this is missing or malformed.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
