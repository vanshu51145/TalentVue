# TalentVue backend — copy to server/.env and fill in real values.
# NEVER commit the real .env. Never paste secrets into this file.

# Port the Express server listens on (Render injects PORT automatically)
PORT=5000

# MongoDB Atlas connection string (SRV). Use your Atlas user/password.
# The server exits on boot if this is missing.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/talentvue?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens (generate a long random string).
# The server exits on boot if this is missing / invalid length.
JWT_SECRET=replace-with-a-long-random-string

# Shared secret for internal AI-service endpoints (resumes scores/analysis).
# Leave out if unused; internal endpoints return 503 without it.
INTERNAL_API_KEY=replace-with-a-long-random-string

# Free Groq key used by chat, question generation, transcription and reports.
# Get it from the Groq console. Never expose it in client code.
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional model overrides.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Optional fallback. OpenAI is used only when GROQ_API_KEY is unset.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Comma-separated exact browser origins allowed by CORS.
# No trailing slashes. Requests without an Origin header are unaffected.
# The server exits on boot if this is missing or malformed.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Public URL of the deployed frontend, used to build password reset links.
# No trailing slash. Defaults to http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# SMTP configuration for sending password reset emails (Nodemailer).
# Use your mail provider's SMTP credentials. NEVER commit real values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Optional "From" address; defaults to SMTP_USER when omitted.
SMTP_FROM=TalentVue <no-reply@example.com>
